# --- Database (Neon Postgres) ---
# Pooled connection (pgbouncer) — used at runtime by Prisma Client
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&pgbouncer=true&connection_limit=1"
# Direct connection (no pooler) — used by Prisma Migrate
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Firebase Auth only (client SDK, safe to expose in browser) ---
# File storage is Cloudinary instead of Firebase Storage — see below —
# because Firebase Storage now requires the paid Blaze plan.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only — from a service account JSON) ---
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private key with literal \n for newlines, keep the quotes
FIREBASE_ADMIN_PRIVATE_KEY=""

# --- Cloudinary (file uploads — payment proofs, loan/emergency documents) ---
# Cloud name from your Cloudinary dashboard; upload preset must be "Unsigned"
# (Settings -> Upload -> Upload presets) so the browser can upload directly.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- Misc ---
# Domain used to build a synthetic email for MemberID-based login (see lib/memberId.js)
MEMBER_LOGIN_EMAIL_DOMAIN="members.alqaimfund.local"
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=admin123
ADMIN_SEED_EMAIL=admin@alqaimfund.local

# --- SMS (optional, feature-flagged via Settings.smsEnabled) ---
SMS_PROVIDER=
SMS_API_KEY=
