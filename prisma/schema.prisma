generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  MEMBER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum InstallmentStatus {
  PENDING
  PAID
  SKIPPED
}

enum PaymentMethod {
  MANUAL_UPLOAD
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

// A loan / emergency-fund request can only be raised for a genuine
// accident or emergency (death in family, accident, medical emergency, etc).
enum EmergencyReason {
  DEATH_IN_FAMILY
  ACCIDENT
  MEDICAL_EMERGENCY
  OTHER_EMERGENCY
}

enum LoanStatus {
  PENDING // submitted by member, awaiting admin review
  APPROVED // admin approved, funds not yet marked disbursed
  REJECTED
  ACTIVE // funds released, repayment in progress
  COMPLETED // fully repaid
}

// Every rupee that moves for a member is logged here so the member
// (and admin) can see a full IN / OUT ledger at any time.
enum TransactionDirection {
  IN // money released TO the member (loan disbursement)
  OUT // money paid BY the member (installment or loan repayment)
}

enum TransactionCategory {
  INSTALLMENT_PAYMENT
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  ADJUSTMENT
  CHARGE_DEDUCTION
}

model Plan {
  id                Int      @id @default(autoincrement())
  code              String   @unique // A, B, C
  name              String
  monthlyAmount     Decimal  @db.Decimal(12, 2)
  tenureMonths      Int      @default(12)
  maxLoanMultiplier Int      @default(20)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users User[]

  @@map("plans")
}

model User {
  id               Int        @id @default(autoincrement())
  firebaseUid      String     @unique
  memberId         String     @unique @db.VarChar(20) // e.g. USR001
  role             Role       @default(MEMBER)
  name             String
  cnic             String?    @unique @db.VarChar(15) // 42101-1234567-1; null for admin accounts
  phone            String
  email            String     @unique
  address          String?
  photoUrl         String? // profile picture, uploaded to Cloudinary — visible to the member and to admin
  planId           Int? // null for admin accounts, required for members
  joinDate         DateTime   @default(now())
  status           UserStatus @default(ACTIVE)
  paidInstallments Int        @default(0)
  totalPaid        Decimal    @default(0) @db.Decimal(14, 2)
  termsAcceptedAt  DateTime? // set once, right after registration, when the member accepts the Terms & Conditions
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  plan         Plan?         @relation(fields: [planId], references: [id])
  installments Installment[]
  payments     Payment[]
  loanRequests LoanRequest[]
  transactions Transaction[]
  charges      Charge[]

  @@map("users")
}

// A manual admin-initiated deduction from a member's accumulated balance
// (e.g. an administrative/service charge) — deliberately does NOT touch
// User.totalPaid or any Installment: the member's plan progress stays
// exactly as it was, this is a separate side record. Also appends a
// CHARGE_DEDUCTION Transaction ledger row so the member sees a clear note
// about it on their own Transactions page.
model Charge {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  reason    String?  @db.Text
  createdAt DateTime @default(now())

  @@map("charges")
}

// A donation from anyone — member or fully anonymous visitor — submitted
// from the public "Donate" button on the landing page. Deliberately not
// linked to a User: donors don't need an account.
model Donation {
  id            Int           @id @default(autoincrement())
  donorName     String
  donorPhone    String
  amount        Decimal       @db.Decimal(12, 2)
  transactionId String?
  proofUrl      String?
  status        PaymentStatus @default(PENDING)
  rejectReason  String?
  createdAt     DateTime      @default(now())

  @@map("donations")
}

model Installment {
  id                Int               @id @default(autoincrement())
  userId            Int
  installmentNumber Int
  amount            Decimal           @db.Decimal(12, 2)
  loanDeduction     Decimal           @default(0) @db.Decimal(12, 2)
  amountPaid        Decimal?          @db.Decimal(12, 2) // actual amount received toward `amount` — may be less than `amount` if admin approved a short payment
  dueDate           DateTime
  paidDate          DateTime?
  status            InstallmentStatus @default(PENDING)
  transactionId     String?
  proofUrl          String?
  createdAt         DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, installmentNumber])
  @@map("installments")
}

model Payment {
  id                    Int           @id @default(autoincrement())
  userId                Int
  amount                Decimal       @db.Decimal(12, 2)
  paymentDate           DateTime
  method                PaymentMethod @default(MANUAL_UPLOAD)
  transactionId         String?
  proofUrl              String?
  status                PaymentStatus @default(PENDING)
  rejectReason          String?
  verifiedAutomatically Boolean       @default(false)
  installmentId         Int?
  createdAt             DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// Loan / Emergency Fund request. Members may only apply when a genuine
// emergency has occurred; a reason + supporting proof are required and
// every request needs admin approval before funds are released.
model LoanRequest {
  id               Int             @id @default(autoincrement())
  userId           Int
  amount           Decimal         @db.Decimal(12, 2)
  reasonCategory   EmergencyReason
  description      String          @db.Text
  proofUrl         String? // e.g. death certificate, hospital receipt
  status           LoanStatus      @default(PENDING)
  adminNote        String?
  approvedDate     DateTime?
  disbursedDate    DateTime?
  monthlyDeduction Decimal?        @db.Decimal(12, 2)
  tenureMonths     Int?
  totalRepaid      Decimal         @default(0) @db.Decimal(14, 2)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  repayments LoanRepayment[]

  @@map("loan_requests")
}

model LoanRepayment {
  id            Int      @id @default(autoincrement())
  loanId        Int
  amount        Decimal  @db.Decimal(12, 2)
  paidDate      DateTime @default(now())
  installmentId Int?

  loan LoanRequest @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@map("loan_repayments")
}

// Full IN / OUT ledger per member, appended to automatically whenever
// money moves (payment approved, loan disbursed, loan repaid).
model Transaction {
  id            Int                  @id @default(autoincrement())
  userId        Int
  direction     TransactionDirection
  category      TransactionCategory
  amount        Decimal              @db.Decimal(12, 2)
  balanceAfter  Decimal              @db.Decimal(14, 2) // net paid-in by member, minus loans received/plus loans repaid
  referenceType String? // "payment" | "installment" | "loan_request" | "loan_repayment"
  referenceId   Int?
  description   String?
  createdAt     DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Settings {
  id                     Int      @id @default(1)
  defaultTenureMonths    Int      @default(12)
  minInstallmentsForLoan Int      @default(12)
  smsEnabled             Boolean  @default(false)
  companyBankDetails     String?  @db.Text
  // Where the automated monthly payments report is emailed — deliberately
  // separate from any admin's login email, since that can be a synthetic
  // placeholder (see ADMIN_SEED_EMAIL) rather than a real inbox.
  reportRecipientEmail   String?
  updatedAt              DateTime @updatedAt

  @@map("settings")
}
